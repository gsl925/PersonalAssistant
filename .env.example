# Personal AI Assistant - Environment Variables
# Copy this file to .env and fill in your values

# === PostgreSQL ===
POSTGRES_PASSWORD=assistant123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_db
POSTGRES_USER=assistant
DATABASE_URL=postgresql+asyncpg://assistant:assistant123@localhost:5432/knowledge_db

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === Telegram Bot ===
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your Telegram chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# === Email (Gmail example) ===
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=your_email@gmail.com

# === Local LLM server ===
# Which engine serves the local models: "llama" (llama.cpp via llama-swap, the default)
# or "ollama". Ollama is used only when you set it here - it is never the silent fallback.
LOCAL_LLM_ENGINE=llama
LLAMA_SWAP_BASE_URL=http://localhost:8090
OLLAMA_LOCAL_BASE_URL=http://localhost:11434
# Optional: point at some other server instead of the engine's address above
# (keep LOCAL_LLM_ENGINE matching what it is).
# LOCAL_LLM_BASE_URL=
# Folder holding the GGUF models for llama.cpp / llama-swap (default: data/llm_models in this repo)
# LLM_MODELS_DIR=D:\llamaModels
# Cloud Ollama endpoint (leave empty if not using)
OLLAMA_CLOUD_BASE_URL=https://api.ollama.com/v1
OLLAMA_CLOUD_API_KEY=your_cloud_api_key

# === App ===
SECRET_KEY=change_this_to_a_random_secret_string
DEBUG=true
LOG_LEVEL=INFO
